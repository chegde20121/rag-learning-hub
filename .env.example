# Application
RAG_APP_NAME=rag-learning-hub
RAG_ENVIRONMENT=local

# Logging
RAG_LOG_LEVEL=INFO
RAG_LOG_FORMAT=json

# API
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000

# Ingestion
RAG_MAX_UPLOAD_MB=20

# PostgreSQL
# Configure when PostgreSQL integration is implemented.
# RAG_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ragdb

# Chroma
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8001
RAG_CHROMA_COLLECTION=rag_documents

# Ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen:8b
RAG_OLLAMA_TIMEOUT_SECONDS=120

# Embeddings
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BATCH_SIZE=32